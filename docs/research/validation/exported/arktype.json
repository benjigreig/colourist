{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "colours": {
   "type": "array",
   "maxItems": 64,
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
     },
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
     },
     "name": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1
     },
     "value": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
     }
    },
    "required": [
     "group",
     "id",
     "name",
     "value"
    ],
    "additionalProperties": false
   }
  },
  "engineVersion": {
   "type": "string",
   "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
  },
  "format": {
   "const": "colourist-project"
  },
  "formatVersion": {
   "type": "integer",
   "maximum": 1000,
   "minimum": 1
  },
  "rulesVersion": {
   "type": "string",
   "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
  },
  "name": {
   "type": "string",
   "maxLength": 120,
   "minLength": 1
  },
  "overrides": {
   "type": "object",
   "patternProperties": {
    "^[a-z][a-zA-Z0-9]{0,40}(\\.[a-zA-Z0-9]{1,40}){0,8}$": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "string"
      },
      {
       "type": "boolean"
      }
     ]
    }
   }
  },
  "target": {
   "enum": [
    "AA",
    "AAA"
   ]
  }
 },
 "required": [
  "colours",
  "engineVersion",
  "format",
  "formatVersion",
  "rulesVersion"
 ],
 "additionalProperties": false
}