{
 "type": "object",
 "required": [
  "format",
  "formatVersion",
  "rulesVersion",
  "engineVersion",
  "colours"
 ],
 "properties": {
  "format": {
   "type": "string",
   "const": "colourist-project"
  },
  "formatVersion": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1000
  },
  "rulesVersion": {
   "type": "string",
   "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
  },
  "engineVersion": {
   "type": "string",
   "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "target": {
   "anyOf": [
    {
     "type": "string",
     "const": "AA"
    },
    {
     "type": "string",
     "const": "AAA"
    }
   ]
  },
  "colours": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "group",
     "value"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
     },
     "value": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
     }
    },
    "additionalProperties": false
   },
   "minItems": 1,
   "maxItems": 64
  },
  "overrides": {
   "type": "object",
   "patternProperties": {
    "^[a-z][a-zA-Z0-9]{0,40}(\\.[a-zA-Z0-9]{1,40}){0,8}$": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "string"
      },
      {
       "type": "boolean"
      }
     ]
    }
   },
   "maxProperties": 200,
   "additionalProperties": false
  }
 },
 "additionalProperties": false
}