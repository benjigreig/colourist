{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colouri.st/schema/project/1.json",
  "title": "colouri.st project (spike version)",
  "description": "What a project, share link or project file stores (D-029, D-045). Spike version for CLR-7's validation assessment; not final.",
  "type": "object",
  "required": ["format", "formatVersion", "rulesVersion", "engineVersion", "colours"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "colourist-project" },
    "formatVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "rulesVersion": { "type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$" },
    "engineVersion": { "type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "target": { "enum": ["AA", "AAA"] },
    "colours": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "name", "group", "value"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "group": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "value": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "overrides": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]{0,40}(\\.[a-zA-Z0-9]{1,40}){0,8}$" },
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    }
  }
}
